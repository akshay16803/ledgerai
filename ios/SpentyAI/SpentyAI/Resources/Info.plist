<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleDisplayName</key>
    <string>SpentyAI</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>com.spentyai.app</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>11</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>MinimumOSVersion</key>
    <string>17.0</string>
    <key>UILaunchScreen</key>
    <dict>
        <key>UIColorName</key>
        <string>spentyBgPrimary</string>
    </dict>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
    </array>
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
        <key>UISceneConfigurations</key>
        <dict/>
    </dict>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>com.googleusercontent.apps.519685265917-uop14njfocs96tmlapprtu60h6b2uvl3</string>
            </array>
            <key>CFBundleURLName</key>
            <string>Google Sign-In</string>
        </dict>
        <dict>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>spentyai</string>
            </array>
            <key>CFBundleURLName</key>
            <string>SpentyAI Email OAuth</string>
        </dict>
    </array>
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <false/>
    </dict>
    <key>NSCameraUsageDescription</key>
    <string>SpentyAI needs camera access to capture receipt photos for automatic expense tracking.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>SpentyAI needs photo library access to select receipt images for expense tracking.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>SpentyAI needs microphone access for voice commands and live voice conversation with the AI assistant.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>SpentyAI uses speech recognition to transcribe your voice into text for the AI chat and Siri shortcuts.</string>
    <!-- UIFileSharingEnabled and LSSupportsOpeningDocumentsInPlace removed:
         SpentyAI does not expose its Documents folder via the Files app.
         Financial exports use share sheets, not Files app integration.
         Keeping these keys on a financial app risks guideline 5.1.1. -->
</dict>
</plist>
