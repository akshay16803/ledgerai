<?xml version="1.0" encoding="utf-8"?>
<!--
    SpentyAI Android - English defaults.

    This file holds the user-facing 20% of strings (Login, Bottom-nav,
    Dashboard, Onboarding hooks, More-menu, common buttons) that are
    seen 80% of the time. The Hindi mirror lives in values-hi/strings.xml
    and is keyed identically. The keys mirror iOS AppStrings.swift so the
    two platforms stay in lockstep.

    See LanguageManager.kt for the in-app language toggle that switches
    between en and hi using AppCompatDelegate.setApplicationLocales().
-->
